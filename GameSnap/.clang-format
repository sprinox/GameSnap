BasedOnStyle: Google
UseTab: Never
IndentWidth: 4
TabWidth: 4
# 列宽不限：日志/格式化字符串里长行很常见，强制折行反而难读。
# 注意：ColumnLimit 为 0 时 AllowShort* 和 BreakStringLiterals 都不会生效，
# 实际行为就是“不合并短语句、不拆分字符串”，所以这里不再设置它们；
# 以后若要引入列宽上限，需要把这几个选项一并补回来。
ColumnLimit: 0
IndentPPDirectives: AfterHash
IndentCaseLabels: false
AccessModifierOffset: -4
NamespaceIndentation: All
FixNamespaceComments: false
# 行尾统一为 LF，避免个别文件被编辑器存成 CRLF 后产生整文件 diff。
# LineEnding 需要 clang-format >= 19；更老的版本用
# DeriveLineEnding: false + UseCRLF: false 代替。
LineEnding: LF
# Include order is semantic here (windows.h before winrt, XInput.h after
# common.h, SPDLOG_NO_EXCEPTIONS before spdlog), so never reorder includes.
SortIncludes: Never
